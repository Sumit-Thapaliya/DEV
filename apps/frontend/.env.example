# Copy to .env.local (or use the tracked .env.local as-is) and restart `pnpm dev`.
# Test values only — real secrets belong in Render / backend .env (git-ignored).

# ─── backend API (browser-side; proxied by the rewrites in next.config.js) ───
# Laptop / sandbox: http://localhost:4000
# Render frontend:  https://<your-backend-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# generate → PDF   (generate() wants a file, so this must be the /pdf route)
NEXT_PUBLIC_ATS_ENDPOINT=https://ats-resume-api-cmkh.onrender.com/v1/format/pdf

# edit → resume JSON by job id
NEXT_PUBLIC_ATS_PARSE_ENDPOINT=https://ats-resume-api-cmkh.onrender.com/v1/parse

# draft: PUT on Save changes, GET on Edit
NEXT_PUBLIC_ATS_DRAFT_ENDPOINT=https://ats-resume-api-cmkh.onrender.com/v1/resume/{jobId}/canvas

NEXT_PUBLIC_ATS_API_KEY=abc

# NEXT_PUBLIC_ATS_MAX_PAGES=1     optional, default 1
